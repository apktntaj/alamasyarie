@model IEnumerable<PersonalWebsite.Models.ProjectViewModel>

@{
    ViewData["Title"] = "Projects";
}

<h1>Projects</h1>
<p>Here are some of the projects I build and maintain.</p>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var project in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@project.Title</h5>
                    <p class="card-text">@project.Description</p>
                    <a class="btn btn-primary" href="@project.Url" target="_blank" rel="noopener">Visit project</a>
                </div>
            </div>
        </div>
    }
</div>

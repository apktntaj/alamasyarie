@model PersonalWebsite.Models.BlogPostViewModel

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p class="text-muted">@Model.Date.ToString("MMMM d, yyyy")</p>
<div class="mb-4">@Html.Raw(Model.HtmlContent)</div>

<p>
    <a asp-controller="Home" asp-action="Blog" class="btn btn-secondary">Back to blog</a>
</p>

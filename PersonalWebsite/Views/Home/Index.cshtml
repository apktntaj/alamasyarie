@{
    ViewData["Title"] = "Home Page";
}

<section class="py-5" style="background: transparent;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="p-4 rounded" style="color: #fff;">
                    <h1 class="display-5 fw-bold">Hello — I'm Alam Asy'arie</h1>
                    <p class="lead">I'm a self-taught developer building web applications while studying computer science through the TeachYourselfCS curriculum.</p>
                    <p class="mb-4 text-white-50">Here I share projects, short CS notes, and technical posts. Explore the sections below to explore.</p>

                    <div class="d-flex gap-2">
                        <a asp-controller="Home" asp-action="Projects" class="btn btn-primary btn-lg">Projects</a>
                        <a asp-controller="Home" asp-action="Blog" class="btn btn-outline-light btn-lg">Blog</a>
                        <a asp-controller="Home" asp-action="Notes" class="btn btn-outline-light btn-lg">CS Notes</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 text-white" style="background: rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                    <div class="card-body">
                        <h5 class="card-title">Projects</h5>
                        <p class="card-text text-white-50">Examples of apps and projects I have built, including ASP.NET Core demos.</p>
                        <a asp-controller="Home" asp-action="Projects" class="stretched-link text-decoration-none text-white fw-semibold">View projects</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 text-white" style="background: rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                    <div class="card-body">
                        <h5 class="card-title">Blog</h5>
                        <p class="card-text text-white-50">Short posts about learning, technical notes, and quick tutorials.</p>
                        <a asp-controller="Home" asp-action="Blog" class="stretched-link text-decoration-none text-white fw-semibold">Read blog</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 text-white" style="background: rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);">
                    <div class="card-body">
                        <h5 class="card-title">CS Notes</h5>
                        <p class="card-text text-white-50">Concise notes on algorithms, data structures, and core CS concepts.</p>
                        <a asp-controller="Home" asp-action="Notes" class="stretched-link text-decoration-none text-white fw-semibold">View notes</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
